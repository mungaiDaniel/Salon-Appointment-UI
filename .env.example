# Copy to .env.local and adjust. Never commit real secrets.

# Base URL of the Flask backend API (used when demo mode is off).
# Defaults to http://localhost:5000/api/v1 if unset.
REACT_APP_API_URL=http://localhost:5000/api/v1

# Demo mode: set to true to use an in-memory mock API with fake sample data.
# No backend and no network calls needed; changes reset on page reload.
# REACT_APP_DEMO_MODE=true
